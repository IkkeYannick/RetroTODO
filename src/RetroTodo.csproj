<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RetroTodo</AssemblyName>
    <RootNamespace>RetroTodo</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationIcon>RetroTodo.ico</ApplicationIcon>

    <!-- Keep the always-running process small -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Windows Smart App Control blocks unsigned .exe files, so the app ships as RetroTodo.dll and is
         started by Microsoft's signed dotnet.exe (via "conhost.exe headless" so no console window shows). -->
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="RetroTodo.ico" LogicalName="RetroTodo.ico" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

</Project>
